{
  "tasks": {
    "run": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv src/mod.ts",

    "build": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv --output bin/clipper src/mod.ts",
    "build:all": "deno task build:linux && deno task build:windows && deno task build:mac",

    "build:linux": "deno task build:x86_64-linux-gnu && deno task build:aarch64-linux-gnu",
    "build:windows": "deno task build:x86_64-pc-windows-msvc",
    "build:mac": "deno task build:x86_64-apple-darwin && deno task build:aarch64-apple-darwin",

    "build:x86_64-linux-gnu": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv --target x86_64-unknown-linux-gnu --output bin/clipper-x86_64-linux-gnu src/mod.ts",
    "build:aarch64-linux-gnu": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv --target aarch64-unknown-linux-gnu --output bin/clipper-aarch64-linux-gnu src/mod.ts",
    "build:x86_64-pc-windows-msvc": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv --target x86_64-pc-windows-msvc --output bin/clipper src/mod.ts",
    "build:x86_64-apple-darwin": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv --target x86_64-apple-darwin --output bin/clipper-x86_64-apple-darwin src/mod.ts",
    "build:aarch64-apple-darwin": "deno compile --allow-read --allow-write --allow-run --allow-env --allow-net --unstable-kv --target aarch64-apple-darwin --output bin/clipper-aarch64-apple-darwin src/mod.ts"
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.0.0-rc.7",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@deno-library/progress": "jsr:@deno-library/progress@^1.5.1",
    "@olli/kvdex": "jsr:@olli/kvdex@^3.4.0",
    "@std/fs": "jsr:@std/fs@^1.0.18",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.7",
    "zod": "npm:zod@^3.25.53"
  }
}
